# ============================================================================
# AMS — .editorconfig
# ============================================================================
# docs/02BACKENDCODINGSTANDARDS.md §1: "One .editorconfig at the repo root is
# law; the build fails on style analyzers."
#
# Rules here are ERRORS, not suggestions, on purpose. Several developers and
# several different AI coding tools write in this repository. A convention
# that only lives in a document is a convention each tool re-invents; a
# convention in this file is one the compiler settles before review.
#
# Changing a severity here changes it for everybody. Do it in a PR of its own,
# with a reason, not as a drive-by inside a feature.
# ============================================================================
root = true

# ----------------------------------------------------------------------------
# Everything
# ----------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,js,html,scss,css,dart}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false   # two trailing spaces is a hard line break

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.sql]
indent_size = 4

# ============================================================================
# C#
# ============================================================================
[*.cs]
indent_size = 4
max_line_length = 140

# ----------------------------------------------------------------------------
# Language rules — 02 §1
# ----------------------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error         # file-scoped namespace

csharp_using_directive_placement = outside_namespace:error
dotnet_diagnostic.IDE0065.severity = error

dotnet_diagnostic.IDE0005.severity = error         # unused usings
                                                   # needs GenerateDocumentationFile,
                                                   # set in Directory.Build.props

csharp_prefer_braces = true:error                  # no brace-less if
dotnet_diagnostic.IDE0011.severity = error

csharp_style_prefer_primary_constructors = true:suggestion   # 02 §4 prefers them,
                                                   # but not every type can have one

dotnet_style_readonly_field = true:error
dotnet_diagnostic.IDE0044.severity = error

csharp_prefer_simple_using_statement = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent          # deliberately unopinionated

dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = false:silent
dotnet_style_prefer_conditional_expression_over_return = false:silent

# Nullable. 02 §1 turns nullable on; these keep it meaningful.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# ----------------------------------------------------------------------------
# Async — 02 §8: "no .Result, .Wait(), async void"
# ----------------------------------------------------------------------------
dotnet_diagnostic.CA2007.severity = none           # ConfigureAwait: this is
                                                   # ASP.NET Core, there is no
                                                   # sync context to escape
dotnet_diagnostic.CA1849.severity = error          # call the async overload
dotnet_diagnostic.CA2012.severity = error          # ValueTask used correctly
dotnet_diagnostic.VSTHRD100.severity = error       # avoid async void
dotnet_diagnostic.VSTHRD002.severity = error       # no .Result / .Wait()

# VSTHRD103 — "call the async version in an async method". Demoted, not
# because the idea is wrong but because it is wrong about EF Core: it flags
# DbSet.Add and demands AddAsync, which EF's own guidance says NOT to use
# unless you are on a value generator like HiLo. Add does not block. Left as a
# suggestion so genuine cases still surface; VSTHRD002 above is the rule that
# actually catches .Result and .Wait().
dotnet_diagnostic.VSTHRD103.severity = suggestion

# ----------------------------------------------------------------------------
# Correctness the review checklist would otherwise have to catch
# ----------------------------------------------------------------------------
dotnet_diagnostic.CA1062.severity = none           # nullable ref types cover this
dotnet_diagnostic.CA1305.severity = error          # specify IFormatProvider
dotnet_diagnostic.CA1310.severity = error          # specify StringComparison
dotnet_diagnostic.CA2100.severity = error          # SQL injection — 03 §6
dotnet_diagnostic.CA2016.severity = error          # forward CancellationToken — 02 §8
dotnet_diagnostic.CA1063.severity = warning
dotnet_diagnostic.CA1816.severity = warning
dotnet_diagnostic.CA1001.severity = error          # own a disposable, be disposable
dotnet_diagnostic.CA1508.severity = warning        # dead conditional code

# Logging — 02 §7: message templates, never interpolation
dotnet_diagnostic.CA2254.severity = error
dotnet_diagnostic.CA1848.severity = suggestion     # LoggerMessage delegates:
                                                   # good, not mandatory

# ----------------------------------------------------------------------------
# Naming — 02 §2
# ----------------------------------------------------------------------------
dotnet_diagnostic.IDE1006.severity = error

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization  = camel_case

dotnet_naming_style.i_prefixed.capitalization = pascal_case
dotnet_naming_style.i_prefixed.required_prefix = I

dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.async_suffixed.capitalization = pascal_case
dotnet_naming_style.async_suffixed.required_suffix = Async

# Interfaces are I-prefixed
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_are_i_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_prefixed.style = i_prefixed
dotnet_naming_rule.interfaces_are_i_prefixed.severity = error

# Constants are PascalCase, whatever their accessibility.
# This rule MUST come before the private-field rule: naming rules are matched
# in the order they appear, and the first match wins. Declared after it, every
# private const would be told to grow an underscore.
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = *
dotnet_naming_symbols.const_fields.required_modifiers = const
dotnet_naming_rule.consts_are_pascal.symbols = const_fields
dotnet_naming_rule.consts_are_pascal.style = pascal_case
dotnet_naming_rule.consts_are_pascal.severity = error

# static readonly is a constant that needed a constructor. Same casing.
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly
dotnet_naming_rule.static_readonly_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_are_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_are_pascal.severity = error

# Private INSTANCE fields are _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel
dotnet_naming_rule.private_fields_are_underscore_camel.severity = error

# Async methods end in Async — 02 §2
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.applicable_accessibilities = *
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = async_suffixed
dotnet_naming_rule.async_methods_end_in_async.severity = error

# Everything public is PascalCase
dotnet_naming_symbols.public_members.applicable_kinds = class,struct,enum,property,method,event,namespace,delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected
dotnet_naming_rule.public_members_are_pascal.symbols = public_members
dotnet_naming_rule.public_members_are_pascal.style = pascal_case
dotnet_naming_rule.public_members_are_pascal.severity = error

# Parameters and locals are camelCase
dotnet_naming_symbols.params_and_locals.applicable_kinds = parameter,local
dotnet_naming_rule.params_and_locals_are_camel.symbols = params_and_locals
dotnet_naming_rule.params_and_locals_are_camel.style = camel_case
dotnet_naming_rule.params_and_locals_are_camel.severity = error

# ----------------------------------------------------------------------------
# Rules we deliberately disagree with, and why
# ----------------------------------------------------------------------------
# Suppressed HERE, once, rather than with a #pragma at each site. A scattered
# suppression is invisible; this list is reviewable, and shrinking it is a
# legitimate piece of work.

# CA1000 — "no static members on generic types". Result<T>.Success(x) and
# Result<T>.Failure(e) are the documented shape (02 §3). The rule protects API
# discoverability for library consumers; this is an internal kernel with one
# consumer, and the factories are the whole point of the pattern.
dotnet_diagnostic.CA1000.severity = none

# CA1716 — "Error conflicts with a reserved keyword". The keyword is VB's. The
# type is named Error in 02 §3, in every handler signature and in the client
# contract. Renaming it to please a language nothing here is written in is the
# wrong trade.
dotnet_diagnostic.CA1716.severity = none

# CA1720 - "identifier contains a type name". AcknowledgementStatus.Signed is
# flagged because "signed" is also a C# numeric modifier. It is not being used
# as one: these constants spell the vocabulary CK_AssetAcknowledgement_Status
# allows, and the database is the authority on that spelling. Renaming the
# constant to satisfy an analyzer would make the C# and the CHECK disagree,
# which is the one thing this design will not tolerate.
dotnet_diagnostic.CA1720.severity = none

# CA1848 / CA1727 — LoggerMessage source generators and logging conventions
# are good practice, not a build gate. 02 §7's actual rule (message templates,
# never interpolation) is CA2254, which IS an error above.
dotnet_diagnostic.CA1727.severity = suggestion

# ============================================================================
# Relaxations, each with a reason
# ============================================================================

# TOTP is RFC 6238, and RFC 6238 specifies HMAC-SHA1. Google Authenticator,
# Microsoft Authenticator and the rest implement SHA1; a "stronger" hash here
# would simply not interoperate with any app a user already has. The weakness
# CA5350 warns about is collision resistance, which a 6-digit code derived from
# a 30-second counter does not depend on.
#
# Scoped to the one file that needs it rather than switched off solution-wide.
[src/Backend/Modules/AMS.Modules.Identity/Authentication/TotpCodes.cs]
dotnet_diagnostic.CA5350.severity = none

# Migrations are generated. Holding generated code to hand-written standards
# means editing generated code, and 03 §5 forbids editing an applied migration.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_analyzer_diagnostic.severity = none

# Tests. Underscored method names read better as sentences, and a test that
# asserts on a null is often testing exactly that.
# Matched on the tests/ folder rather than a *Tests glob: the glob form does
# not reliably match a file sitting directly in the project folder.
[src/Backend/tests/**/*.cs]
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CA2007.severity = none

# CA2100 — SQL built from a string. Test fixtures create and drop their own
# scratch database from literal SQL; there is no user input within reach. The
# rule stays an ERROR in src/, which is where it matters (03 §6).
dotnet_diagnostic.CA2100.severity = none

# xUnit1051 — thread TestContext.Current.CancellationToken into every awaited
# call. Worth it for a long-running suite; here it would put a token on every
# line of a fixture that runs in a second, and hide the thing each test is
# actually saying. Left visible as a suggestion.
dotnet_diagnostic.xUnit1051.severity = suggestion
