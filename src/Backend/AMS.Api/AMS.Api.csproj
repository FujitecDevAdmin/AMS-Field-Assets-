<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Visual Studio/F5 starts the Angular CLI and opens this URL through
         Microsoft.AspNetCore.SpaProxy. The Angular app continues to proxy
         /api requests back to this host on port 5069. -->
    <SpaRoot>..\..\Web\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:4200</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
  </PropertyGroup>

  <!--
    The ONE host. docs/01ARCHITECTURE.md §1.

    This project references every module so it can wire them at startup, and
    that is the ONLY project permitted to do so. A module referencing another
    module is the boundary violation the architecture tests fail the build on.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMS.SharedKernel\AMS.SharedKernel.csproj" />
    <ProjectReference Include="..\AMS.Infrastructure\AMS.Infrastructure.csproj" />
    <ProjectReference Include="..\AMS.Reporting\AMS.Reporting.csproj" />
    <ProjectReference Include="..\Modules\**\*.csproj" />
  </ItemGroup>

</Project>
