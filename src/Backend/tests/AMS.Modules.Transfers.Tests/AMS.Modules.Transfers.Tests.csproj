    applies the change and writes its timeline, all through contracts. Testing
    it with one schema present would prove something the application does not do.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\AMS.Modules.Transfers\AMS.Modules.Transfers.csproj" />
    <ProjectReference Include="..\..\Modules\AMS.Modules.Assets\AMS.Modules.Assets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
