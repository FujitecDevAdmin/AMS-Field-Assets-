<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The composition root's tests. Everything else in this solution tests a
    handler by calling it; these boot the REAL host and go over HTTP, because
    what they are testing is the wiring itself: does authentication work, does
    a capability gate return 403, does a command roll back through the
    dispatcher.

    A handler test cannot answer any of those - it never touches the pipeline.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AMS.Api\AMS.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
