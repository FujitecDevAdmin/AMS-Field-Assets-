<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Identity's tests. Integration, against a real SQL Server, because the rules
    being tested are enforced by the database: unique indexes, filtered
    indexes, cascade deletes. A mocked DbContext would pass while the schema
    disagreed (docs/01 §7).
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\AMS.Modules.Identity\AMS.Modules.Identity.csproj" />
    <!-- For the real JWT issuer. A sign-in test that stubs the token proves
         nothing about the claims every other module reads. -->
    <ProjectReference Include="..\..\AMS.Infrastructure\AMS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
