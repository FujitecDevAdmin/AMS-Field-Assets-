<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration, against a real SQL Server. The rules under test are the ones
    the schema enforces: unique category names, one sub-category name per
    category, and the filtered unique index that allows exactly one default team.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\AMS.Modules.ServiceDesk\AMS.Modules.ServiceDesk.csproj" />
    <!--
      The two contracts the approval resolver takes. Referenced for the
      INTERFACES only - the tests stub them, because ServiceDesk should be
      testable without an Identity database standing behind it.
    -->
    <ProjectReference Include="..\..\Modules\AMS.Modules.Identity.PublicApi\AMS.Modules.Identity.PublicApi.csproj" />
    <ProjectReference Include="..\..\Modules\AMS.Modules.Organization.PublicApi\AMS.Modules.Organization.PublicApi.csproj" />
    <ProjectReference Include="..\..\Modules\AMS.Modules.ServiceLevel.PublicApi\AMS.Modules.ServiceLevel.PublicApi.csproj" />
    <ProjectReference Include="..\..\Modules\AMS.Modules.Notifications.PublicApi\AMS.Modules.Notifications.PublicApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
