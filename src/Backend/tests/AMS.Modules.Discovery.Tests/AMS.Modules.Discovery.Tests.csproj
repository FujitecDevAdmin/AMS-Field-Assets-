<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration, against a real SQL Server. The agent endpoint is exercised the
    way an agent uses it - a real key, hashed and looked up by prefix - because
    the thing worth testing is what happens when the key is wrong.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\AMS.Modules.Discovery\AMS.Modules.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
