<Project>

  <!--
    ==========================================================================
    AMS — Central Package Management
    ==========================================================================
    Every package version in the solution is decided HERE. Projects reference
    a package by name only:

        <PackageReference Include="FluentValidation" />

    A version attribute in a .csproj is a build error, and that is the point:
    five developers adding packages independently is how one solution ends up
    running three versions of the same library and nobody can say which.

    Upgrading anything below is a PR of its own, so the change is reviewable
    and revertable on its own. docs/04 §3 already says this about DevExtreme;
    it is true of the backend too.
    ==========================================================================
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Entity Framework Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <!--
      Bearer tokens. The capability set travels IN the token, which is what
      keeps [Identity] out of the path of every request in every other module
      (01 §2 rule 2).
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- 8.19.2, matching what JwtBearer 10.0.11 pulls in. Anything lower is a
         downgrade NuGet refuses, and pinning it here keeps the two in step. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup Label="Composition — used by the persistence kernel">
    <!--
      The dispatcher lives in AMS.SharedKernel.Persistence and needs to resolve
      handlers and log a rollback. Abstractions only: that project must not
      drag a container implementation into every module that references it.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Transitive pins — security">
    <!--
      Not referenced by any project directly. These are pulled in by packages
      above and are pinned here because NuGetAudit found the versions those
      packages ask for to be vulnerable, and the build treats that as an error.

      CentralPackageTransitivePinningEnabled (Directory.Build.props) is what
      makes a PackageVersion here able to override a dependency's choice.

      Delete a line when the parent package catches up. Verify by removing it
      and confirming `dotnet restore` stays quiet, not by assuming.
    -->
    <!-- via DevExpress.Document.Processor: GHSA-23rf-6693-g89p and four more -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="DevExpress — covered by the Universal licence">
    <!--
      ONE package for every document the server produces: Spreadsheet (xlsx),
      RichEdit (docx) and PDF all live in Document.Processor. The Universal
      licence already covers it, so there is no reason to add ClosedXML,
      EPPlus or QuestPDF beside it and end up with four document libraries.

      Held at the SAME 26.1.x as the DevExtreme version docs/04 §3 pins. The
      two halves of a DevExpress upgrade move together or not at all.
    -->
    <PackageVersion Include="DevExpress.Document.Processor" Version="26.1.3" />
  </ItemGroup>

  <ItemGroup Label="Analyzers — applied solution-wide from Directory.Build.props">
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <!-- Boots the real host over HTTP. The composition root is the one
         thing a handler test cannot reach. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

</Project>
