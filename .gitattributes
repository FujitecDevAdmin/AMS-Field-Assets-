# Normalise line endings. Without this, five developers on mixed machines
# produce whole-file diffs that hide the one line that actually changed.
* text=auto eol=lf

# Windows-only files keep CRLF or they will not run.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf

# Source and config: LF everywhere.
*.cs        text eol=lf diff=csharp
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.scss      text eol=lf
*.css       text eol=lf
*.dart      text eol=lf
*.editorconfig text eol=lf

# Binary. Never diffed, never normalised, never merged.
*.docx      binary
*.xlsx      binary
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.snk       binary
*.pfx       binary
*.zip       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
